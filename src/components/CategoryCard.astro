---
import type { CatNode } from '../lib/tree';
import { countPosts } from '../lib/tree';
import { isCategoryLocked } from '../lib/locked';
import { categoryDisplayName } from '../lib/category-names';
import { categoryCover } from '../lib/category-covers';

interface Props {
  node: CatNode;
}
const { node } = Astro.props;

const href = `/category/${node.path.join('/')}/`;
const count = countPosts(node);
const cleanName = categoryDisplayName(node.name);
const locked = isCategoryLocked(node.path);
const cover = categoryCover(node.name);
---
<a
  class:list={['blog-card', cover && 'has-cover']}
  href={href}
  title={node.name}
  style={cover ? `background-image: url('${cover}')` : undefined}
>
  {locked && (
    <svg
      class="book-lock"
      viewBox="0 0 24 24"
      role="img"
      aria-label="비공개"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="5" y="11" width="14" height="10" rx="2" />
      <path d="M8 11V7a4 4 0 0 1 8 0v4" />
    </svg>
  )}
  <div class="book-center">
    <h3 class="book-title">{cleanName}</h3>
    <span class="book-meta">{count}편의 글</span>
  </div>
</a>
