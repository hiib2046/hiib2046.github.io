---
import CategoryCard from './CategoryCard.astro';
import PostItem from './PostItem.astro';
import type { CatNode } from '../lib/tree';
import type { Post } from '../lib/posts';

interface Props {
  subs: CatNode[];
  posts: Post[];
}
const { subs, posts } = Astro.props;
---
{
  subs.length > 0 && (
    <div class="cat-grid-wrap">
      <button class="cat-nav cat-nav-prev" type="button" aria-label="이전 카드" hidden>‹</button>
      <div class="cat-grid">
        {subs.map((s) => (
          <CategoryCard node={s} />
        ))}
      </div>
      <button class="cat-nav cat-nav-next" type="button" aria-label="다음 카드" hidden>›</button>
    </div>
  )
}
{
  posts.length > 0 && (
    <div class="post-list">
      {posts.map((post) => (
        <PostItem post={post} />
      ))}
    </div>
  )
}
