---
import CategoryCard from './CategoryCard.astro';
import PostItem from './PostItem.astro';
import type { CatNode } from '../lib/tree';
import type { Post } from '../lib/posts';

interface Props {
  subs: CatNode[];
  posts: Post[];
}
const { subs, posts } = Astro.props;
---
{
  subs.length > 0 && (
    <div class="cat-grid-wrap">
      <button class="cat-nav cat-nav-prev" type="button" aria-label="이전 카드" hidden>‹</button>
      <div class="cat-grid">
        {subs.map((s) => (
          <CategoryCard node={s} />
        ))}
      </div>
      <button class="cat-nav cat-nav-next" type="button" aria-label="다음 카드" hidden>›</button>
    </div>
  )
}
{
  posts.length > 1 && (
    <div class="sort-toggle">
      <button class="sort-btn is-active" type="button" data-sort="newest">
        최신순
      </button>
      <button class="sort-btn" type="button" data-sort="oldest">
        오래된순
      </button>
    </div>
  )
}
{
  posts.length > 0 && (
    <div class="post-list">
      {posts.map((post) => (
        <PostItem post={post} />
      ))}
    </div>
  )
}
{
  subs.length === 0 && posts.length === 0 && (
    <p class="empty-cat">아직 글이 없습니다.</p>
  )
}

<style>
  .empty-cat {
    width: 100%;
    max-width: var(--read-w);
    margin: 3rem 0 5rem;
    color: var(--muted);
  }
</style>
