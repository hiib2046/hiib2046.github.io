---
import '../styles/global.css';
import { topCategories } from '../lib/tree';
import { categoryDisplayName } from '../lib/category-names';

interface Props {
  title: string;
  activeCategory?: string;
  isList?: boolean;
}
const { title, activeCategory, isList = false } = Astro.props;
const categories = await topCategories();
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@700&family=Noto+Sans+KR:wght@350;700&display=swap"
      rel="stylesheet"
    />
    <link rel="alternate" type="application/rss+xml" title="ATELIER" href="/rss.xml" />
    <script is:inline>
      // FOUC 방지: 페인트 전에 저장된 테마·사이드바 상태를 즉시 html에 적용
      const t = localStorage.getItem('theme') || 'light';
      document.documentElement.dataset.theme = t;
      const nav = localStorage.getItem('nav') || 'open';
      document.documentElement.dataset.nav = nav;
    </script>
  </head>
  <body>
    <button id="nav-toggle" class="nav-toggle" type="button" aria-label="메뉴 접기"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
    <button id="theme-toggle" class="toggle" type="button" aria-label="다크 모드로 전환"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg></button>
    <div class="layout">
      <aside class="sidebar">
        <nav class="cats">
          {
            categories.map((c) => (
              <a
                href={`/category/${c.path.join('/')}/`}
                class={c.name === activeCategory ? 'cat active' : 'cat'}
              >
                {categoryDisplayName(c.name)}
              </a>
            ))
          }
        </nav>
      </aside>
      <main class:list={['content', { 'list-content': isList }]}>
        <slot />
      </main>
    </div>
    <script>
      // 토글: 현재 테마를 뒤집어 html[data-theme]와 localStorage에 반영(새로고침에도 유지)
      const btn = document.getElementById('theme-toggle');
      // 라인 아이콘(currentColor라 테마색 따라감): 다크면 해(누르면 밝아짐), 라이트면 달(누르면 어두워짐)
      const SVG = 'xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
      const SUN = `<svg ${SVG}><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>`;
      const MOON = `<svg ${SVG}><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>`;
      // 현재 테마에 맞춰 아이콘·라벨 동기화
      const syncToggle = (theme) => {
        const dark = theme === 'dark';
        btn.innerHTML = dark ? SUN : MOON;
        btn.setAttribute('aria-label', dark ? '라이트 모드로 전환' : '다크 모드로 전환');
      };
      if (btn) syncToggle(document.documentElement.dataset.theme);
      btn?.addEventListener('click', () => {
        const next =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        syncToggle(next);
      });

      // 사이드바 접기/펴기 토글 (상태를 localStorage에 저장해 새로고침에도 유지)
      const navBtn = document.getElementById('nav-toggle');
      const CHEVRON_LEFT = `<svg ${SVG}><path d="m15 18-6-6 6-6"/></svg>`;
      const CHEVRON_RIGHT = `<svg ${SVG}><path d="m9 18 6-6-6-6"/></svg>`;
      // 사이드바 상태에 맞춰 화살표·라벨 동기화: 열림이면 접기(‹), 닫힘이면 펼치기(›)
      const syncNav = (nav) => {
        const closed = nav === 'closed';
        navBtn.innerHTML = closed ? CHEVRON_RIGHT : CHEVRON_LEFT;
        navBtn.setAttribute('aria-label', closed ? '메뉴 펼치기' : '메뉴 접기');
      };
      if (navBtn) syncNav(document.documentElement.dataset.nav);
      navBtn?.addEventListener('click', () => {
        const next =
          document.documentElement.dataset.nav === 'closed' ? 'open' : 'closed';
        document.documentElement.dataset.nav = next;
        localStorage.setItem('nav', next);
        syncNav(next);
      });
    </script>
  </body>
</html>
